{
  "_comment": "Starting point only. Generate the real file with `alexa-ai new mcp --name \"Local Pulse\" --locale en-US --mcp-server-url <your https url>/mcp`, then copy these values in. Match the mediaAssets key names to what the CLI generates. Limits: name <=30 chars, shortDescription <=123, 3-4 examplePhrases <=200 each.",
  "manifestVersion": "1.0",
  "storeListing": {
    "distributionCountries": [
      "US"
    ],
    "locales": {
      "en-US": {
        "name": "Local Pulse",
        "shortDescription": "Hear how AI assistants recommend your business, across every location, and reply to reviews by voice.",
        "fullDescription": "Local Pulse tells multi-location business owners how often ChatGPT, Gemini and Perplexity recommend them, which location needs attention, and which reviews are waiting for a reply. It drafts replies for you, and nothing is posted until you say yes.",
        "examplePhrases": [
          "Alexa, ask Local Pulse how my four clinics are showing up in AI search this week",
          "Alexa, ask Local Pulse which location has unanswered reviews",
          "Alexa, ask Local Pulse to draft replies to the negative reviews"
        ],
        "privacyAndCompliance": {
          "privacyPolicyUrl": "https://github.com/pranjalvatsa/local-pulse/blob/main/PRIVACY.md",
          "termsOfUseUrl": "https://github.com/pranjalvatsa/local-pulse/blob/main/TERMS.md"
        },
        "mediaAssets": {
          "icons": {
            "light": {
              "72x72": "https://raw.githubusercontent.com/pranjalvatsa/local-pulse/main/alexa-addon-assets/icon-72.png",
              "64x64": "https://raw.githubusercontent.com/pranjalvatsa/local-pulse/main/alexa-addon-assets/icon-64.png",
              "88x88": "https://raw.githubusercontent.com/pranjalvatsa/local-pulse/main/alexa-addon-assets/icon-88.png",
              "126x126": "https://raw.githubusercontent.com/pranjalvatsa/local-pulse/main/alexa-addon-assets/icon-126.png",
              "180x180": "https://raw.githubusercontent.com/pranjalvatsa/local-pulse/main/alexa-addon-assets/icon-180.png",
              "241x241": "https://raw.githubusercontent.com/pranjalvatsa/local-pulse/main/alexa-addon-assets/icon-241.png"
            }
          },
          "carouselImages": [
            {
              "uri": "https://raw.githubusercontent.com/pranjalvatsa/local-pulse/main/alexa-addon-assets/carousel-1.png",
              "altText": "Local Pulse answering how four clinics show up in AI search, then drafting review replies that wait for the owner's approval."
            }
          ],
          "bannerImages": [
            {
              "uri": "https://raw.githubusercontent.com/pranjalvatsa/local-pulse/main/alexa-addon-assets/banner-1.png"
            }
          ]
        }
      }
    }
  },
  "integrations": [
    {
      "type": "MCP",
      "config": {
        "endpoints": {
          "default": {
            "type": "HTTPS",
            "uri": "https://YOUR-MCP-HOST/mcp"
          }
        }
      }
    }
  ]
}
